n = int(input("Enter number of online orders: "))
orders = []

for i in range(n):
    time = int(input("Enter delivery time (in minutes): "))
    orders.append(time)

print("\nOriginal Delivery Times:")
print(orders)

merge_sort(orders)

print("\nSorted Delivery Times (Fastest First):")
print(orders)
